# Kafka Test Framework - Пример переменных окружения для Docker
# Скопируйте этот файл в .env и заполните реальными значениями

# ==================== Обязательные параметры ====================

# Пароли для SSL сертификатов
KAFKA_SSL_TRUSTSTORE_PASSWORD=your_truststore_password_here
KAFKA_SSL_KEYSTORE_PASSWORD=your_keystore_password_here

# Kafka REST API пароль
KAFKA_REST_API_PASSWORD=your_rest_api_password_here

# Schema Registry пароль
KAFKA_SCHEMA_REGISTRY_PASSWORD=your_schema_registry_password_here

# ==================== Опциональные параметры ====================

# Kafka подключение (можно переопределить)
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_SECURITY_PROTOCOL=SSL

# Kafka REST API
# KAFKA_REST_API_URL=
# KAFKA_REST_API_USERNAME=

# Schema Registry
# KAFKA_SCHEMA_REGISTRY_URL=
# KAFKA_SCHEMA_REGISTRY_USERNAME=

# SSL Key пароль (если отличается от keystore)
# KAFKA_SSL_KEY_PASSWORD=

# ==================== Настройки тестирования ====================

# Количество потоков для параллельного запуска
THREAD_COUNT=1

# Группа тестов для запуска (producer, consumer, smoke, critical, и т.д.)
# TEST_GROUPS=smoke

# Окружение (local, ci)
TEST_ENV=local

# Таймауты тестов (в секундах)
TEST_TIMEOUT_SECONDS=30
TEST_POLL_TIMEOUT_SECONDS=5

# Очищать топики после тестов (true/false)
TEST_CLEANUP_TOPICS=true

# Детальное логирование (true/false)
LOGGING_DETAILED=true

# ==================== Инструкции ====================
# 
# 1. Скопируйте этот файл:
#    cp .env.example .env
#
# 2. Заполните обязательные пароли
#
# 3. Убедитесь, что SSL сертификаты находятся в docker/kafka_key/:
#    - kafka.truststore.jks
#    - kafka.keystore.p12
#
# 4. Запустите тесты:
#    docker-compose run --rm kafka-tests mvn clean test
#
