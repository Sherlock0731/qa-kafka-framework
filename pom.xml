<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>qa.autotest</groupId>
    <artifactId>kafka-test-framework</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>Kafka Test Automation Framework</name>
    <description>Multi-threaded Kafka testing framework with JUnit5, AssertJ, Allure</description>

    <properties>
        <!-- Java Version -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependencies Versions -->
        <junit.version>5.10.1</junit.version>
        <assertj.version>3.24.2</assertj.version>
        <gson.version>2.10.1</gson.version>
        <allure.version>2.25.0</allure.version>
        <lombok.version>1.18.30</lombok.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.14</logback.version>
        <jackson.version>2.16.1</jackson.version>
        <owner.version>1.0.12</owner.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <kafka-clients.version>3.6.1</kafka-clients.version>
        <awaitility.version>4.2.0</awaitility.version>

        <!-- Plugins Versions -->
        <maven-surefire-plugin.version>3.2.3</maven-surefire-plugin.version>
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <allure-maven.version>2.12.0</allure-maven.version>
        <aspectj.version>1.9.21</aspectj.version>
        <mockito.version>5.11.0</mockito.version>

        <!-- Test Execution Parameters -->
        <thread.count>1</thread.count>
        <test.groups></test.groups>

        <!-- По умолчанию оба execution включены -->
        <skip.unit.tests>false</skip.unit.tests>
        <skip.integration.tests>false</skip.integration.tests>

        <!--
            Паттерны для юнит-тестов (пакет qa.autotest.framework.**).
            Surefire сопоставляет паттерны с именами классов в target/test-classes.
        -->
        <unit.test.pattern>qa/autotest/framework/**/*Test.class</unit.test.pattern>

        <!--
            Паттерны для интеграционных тестов (пакет tests.**).
        -->
        <integration.test.pattern>tests/**/*Tests.class</integration.test.pattern>

    </properties>

    <dependencies>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
        </dependency>

        <!-- Kafka Clients -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka-clients.version}</version>
        </dependency>

        <!-- REST Assured for API Testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- Awaitility for async testing -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
        </dependency>

        <!-- Gson for JSON serialization -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- Allure -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Owner for configuration -->
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
            <version>${owner.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Maven Surefire Plugin — два отдельных execution:

                1) unit-tests   — запускает qa/autotest/framework/**/*Test.java
                                  БЕЗ aspectjweaver и БЕЗ allure.results.directory,
                                  поэтому Allure listener не активен и файлы
                                  в allure-results не пишутся.

                2) integration-tests — запускает tests/**/*Test.java
                                  С aspectjweaver + allure.results.directory,
                                  результаты идут в отчёт Allure как обычно.

                Запуск только юнит-тестов:
                    mvn test -Dskip.integration.tests=true

                Запуск только интеграционных тестов:
                    mvn test -Dskip.unit.tests=true

                Запуск всех тестов (по умолчанию):
                    mvn test
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>

                <!-- Отключаем default execution — управляем вручную через executions -->
                <configuration>
                    <skip>true</skip>
                </configuration>

                <executions>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION 1: Юнит-тесты
                         Пакет: qa.autotest.framework.**
                         Allure: ВЫКЛЮЧЕН (нет aspectjweaver, нет allure.results.directory)
                         Отчёты: target/surefire-reports/unit
                         ══════════════════════════════════════════════════════ -->
                    <execution>
                        <id>unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.unit.tests}</skip>
                            <includes>
                                <include>${unit.test.pattern}</include>
                            </includes>
                            <reportsDirectory>${project.build.directory}/surefire-reports/unit</reportsDirectory>
                            <parallel>none</parallel>
                            <threadCount>1</threadCount>
                            <perCoreThreadCount>false</perCoreThreadCount>
                            <rerunFailingTestsCount>2</rerunFailingTestsCount>
                            <useFile>true</useFile>
                            <!--
                                Намеренно НЕ задаём allure.results.directory —
                                Allure listener не найдёт директорию и не запишет результаты.
                                Также НЕ подключаем aspectjweaver — он нужен только для
                                перехвата аннотаций Allure в интеграционных тестах.
                            -->
                            <systemPropertyVariables>
                                <ssl.keystore.type>PKCS12</ssl.keystore.type>
                                <ssl.truststore.type>JKS</ssl.truststore.type>
                                <junit.jupiter.execution.parallel.config.fixed.max-pool-size>${thread.count}</junit.jupiter.execution.parallel.config.fixed.max-pool-size>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION 2: Интеграционные тесты
                         Пакет: tests/**
                         Allure: ВКЛЮЧЁН (aspectjweaver + allure.results.directory)
                         Отчёты: target/surefire-reports/integration
                                 target/allure-results
                         ══════════════════════════════════════════════════════ -->
                    <execution>
                        <id>integration-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.integration.tests}</skip>
                            <includes>
                                <include>${integration.test.pattern}</include>
                            </includes>
                            <!-- File-pattern excludes: исключаем пакет юнит-тестов из сканирования -->
                            <excludes>
                                <exclude>${unit.test.pattern}</exclude>
                            </excludes>
                            <excludedGroups>unit</excludedGroups>
                            <groups>${test.groups}</groups>
                            <reportsDirectory>${project.build.directory}/surefire-reports/integration</reportsDirectory>
                            <parallel>none</parallel>
                            <threadCount>1</threadCount>
                            <perCoreThreadCount>false</perCoreThreadCount>
                            <rerunFailingTestsCount>2</rerunFailingTestsCount>
                            <useFile>true</useFile>
                            <systemPropertyVariables>
                                <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                                <ssl.keystore.type>PKCS12</ssl.keystore.type>
                                <ssl.truststore.type>JKS</ssl.truststore.type>
                                <junit.jupiter.execution.parallel.config.fixed.max-pool-size>${thread.count}</junit.jupiter.execution.parallel.config.fixed.max-pool-size>
                            </systemPropertyVariables>
                            <argLine>
                                -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                            </argLine>
                        </configuration>
                    </execution>

                </executions>

                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Allure Maven Plugin -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Environment profiles -->
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>local</env>
            </properties>
        </profile>

        <profile>
            <id>ci</id>
            <properties>
                <env>ci</env>
            </properties>
        </profile>

        <!-- Test group profiles -->
        <profile>
            <id>producer</id>
            <properties>
                <test.groups>producer</test.groups>
            </properties>
        </profile>

        <profile>
            <id>consumer</id>
            <properties>
                <test.groups>consumer</test.groups>
            </properties>
        </profile>

        <profile>
            <id>idempotence</id>
            <properties>
                <test.groups>idempotence</test.groups>
            </properties>
        </profile>

        <profile>
            <id>ordering</id>
            <properties>
                <test.groups>ordering</test.groups>
            </properties>
        </profile>

        <profile>
            <id>offset</id>
            <properties>
                <test.groups>offset</test.groups>
            </properties>
        </profile>

        <profile>
            <id>error-handling</id>
            <properties>
                <test.groups>error-handling</test.groups>
            </properties>
        </profile>

        <profile>
            <id>partitioning</id>
            <properties>
                <test.groups>partitioning</test.groups>
            </properties>
        </profile>

        <profile>
            <id>consumer-group</id>
            <properties>
                <test.groups>consumer-group</test.groups>
            </properties>
        </profile>

        <profile>
            <id>dlq</id>
            <properties>
                <test.groups>dlq</test.groups>
            </properties>
        </profile>

        <profile>
            <id>smoke</id>
            <properties>
                <test.groups>smoke</test.groups>
            </properties>
        </profile>

        <profile>
            <id>critical</id>
            <properties>
                <test.groups>critical</test.groups>
            </properties>
        </profile>

        <!-- Parallel execution profile -->
        <profile>
            <id>parallel</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <!-- Переопределяем только integration-tests execution для параллельного запуска -->
                            <execution>
                                <id>integration-tests</id>
                                <configuration>
                                    <systemPropertyVariables>
                                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                                        <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
                                        <junit.jupiter.execution.parallel.mode.default>concurrent</junit.jupiter.execution.parallel.mode.default>
                                        <junit.jupiter.execution.parallel.mode.classes.default>concurrent</junit.jupiter.execution.parallel.mode.classes.default>
                                        <junit.jupiter.execution.parallel.config.fixed.max-pool-size>${thread.count}</junit.jupiter.execution.parallel.config.fixed.max-pool-size>
                                        <ssl.keystore.type>PKCS12</ssl.keystore.type>
                                        <ssl.truststore.type>JKS</ssl.truststore.type>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ═══════════════════════════════════════════════════════
             Security profile: mvn verify -P security-check -DnvdApiKey=YOUR_KEY
             Получить API ключ: https://nvd.nist.gov/developers/request-an-api-key
             ═══════════════════════════════════════════════════════ -->
        <profile>
            <id>security-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>9.0.10</version>
                        <configuration>
                            <!-- Передавать ключ: -DnvdApiKey=YOUR_REAL_KEY -->
                            <!--suppress UnresolvedMavenProperty -->
                            <nvdApiKey>${nvdApiKey}</nvdApiKey>
                            <!-- Задержка между API запросами (мс) — увеличь при 403 ошибках -->
                            <nvdApiDelay>4000</nvdApiDelay>
                            <!-- Падать при CVSS >= 7 (высокий и критический) -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- HTML + JSON отчёт -->
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
