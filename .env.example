# Kafka Test Framework - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Kafka SSL Certificates
KAFKA_SSL_TRUSTSTORE_PASSWORD=your_truststore_password
KAFKA_SSL_KEYSTORE_PASSWORD=your_keystore_password

# Kafka REST API
KAFKA_REST_API_PASSWORD=your_rest_api_password

# Schema Registry
KAFKA_SCHEMA_REGISTRY_PASSWORD=your_schema_registry_password

# Optional: Override default paths
# KAFKA_SSL_TRUSTSTORE_LOCATION=/custom/path/kafka.truststore.jks
# KAFKA_SSL_KEYSTORE_LOCATION=/custom/path/kafka.keystore.p12
